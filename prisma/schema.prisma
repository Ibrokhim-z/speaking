generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("MANAGER") // MANAGER or MAIN_MANAGER
  createdAt DateTime @default(now())
  students  Student[]
}

model Student {
  id              String           @id @default(cuid())
  fullName        String
  phone           String           @default("")
  createdAt       DateTime         @default(now())
  managerId       String
  manager         User             @relation(fields: [managerId], references: [id])
  testResults     TestResult[]
  speakingSessions SpeakingSession[]
}

model TestResult {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int
  totalQuestions Int
  level       String
  answers     String   // JSON string of answers
  createdAt   DateTime @default(now())
}

model SpeakingSession {
  id            String          @id @default(cuid())
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level         String
  overallScore  Int             @default(0)
  feedback      String          @default("")
  feedbackLang  String          @default("en")
  status        String          @default("in_progress") // in_progress, completed
  createdAt     DateTime        @default(now())
  answers       SpeakingAnswer[]
}

model SpeakingAnswer {
  id            String          @id @default(cuid())
  sessionId     String
  session       SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex Int
  questionText  String
  audioPath     String          @default("")
  transcription String          @default("")
  score         Int             @default(0)
  feedback      String          @default("")
  createdAt     DateTime        @default(now())
}
